! 1. Параметры
R = 1.0          ! Радиус идеальной окружности
CENTER_X = 0.0   ! Координаты центра
CENTER_Y = 0.0
THRESHOLD_ANGLE = 150  ! Порог для угла (градусы)
THRESHOLD_DIST = 0.05  ! Допуск отклонения от радиуса (5%)

! 2. Цикл по узлам
*GET, N_NODE, NODE, 0, COUNT  ! Число узлов
*DIM, DEFECTIVE, ARRAY, N_NODE ! Массив для пометки дефектных узлов

*DO, I, 1, N_NODE
  ! Координаты текущего узла
  NODE_X = NX(I)
  NODE_Y = NY(I)
  
  ! Проверка отклонения от радиуса
  DIST = SQRT((NODE_X - CENTER_X)**2 + (NODE_Y - CENTER_Y)**2)
  *IF, ABS(DIST - R)/R, GT, THRESHOLD_DIST, THEN
    DEFECTIVE(I) = 1  ! Пометить как дефектный
  *ENDIF
  
  ! Проверка угла (если не на границе)
  *IF, I, GT, 1, AND, I, LT, N_NODE, THEN
    ! Вектора a (P_i-1 -> P_i) и b (P_i -> P_i+1)
    AX = NX(I) - NX(I-1)
    AY = NY(I) - NY(I-1)
    BX = NX(I+1) - NX(I)
    BY = NY(I+1) - NY(I)
    ! Косинус угла
    COS_THETA = (AX*BX + AY*BY) / (SQRT(AX**2 + AY**2) * SQRT(BX**2 + BY**2))
    THETA = ACOS(COS_THETA) * 180/3.14159  ! В градусах
    *IF, THETA, LT, THRESHOLD_ANGLE, THEN
      DEFECTIVE(I) = 1  ! Пометить как дефектный
    *ENDIF
  *ENDIF
*ENDDO

! 3. Применение 7-точечного сглаживания ТОЛЬКО к дефектным узлам
*DO, I, 4, N_NODE-3  ! Игнорируем граничные узлы
  *IF, DEFECTIVE(I), EQ, 1, THEN
    ! Формула сглаживания (адаптированная для APDL)
    Y_NEW = (7*NY(I) + 6*(NY(I+1) + NY(I-1)) + 3*(NY(I+2) + NY(I-2)) - 2*(NY(I+3) + NY(I-3))) / 21
    ! Обновляем координату Y (X можно оставить без изменений для окружности)
    N, I, NX(I), Y_NEW
  *ENDIF
*ENDDO