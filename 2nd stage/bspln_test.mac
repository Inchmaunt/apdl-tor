*DIM, DEFECTIVE, ARRAY, lowNodes 
*DIM, Theta, ARRAY, lowNodes 
*DIM, NODE_X, ARRAY, lowNodes 
*DIM, NODE_Y, ARRAY, lowNodes


N_NODE=lowNodes
!*VREAD, Y_NEW, D:\high123123, TXT, --, JIK, 241, 1, 1, 0

*CREATE,ansuitmp12
*VREAD,Y_NEW,'high123123','txt','D:\',IJK,241,1,1,0

(1F10.4)
*CFCLOS
*END
*USE, ansuitmp12

*CREATE,ansuitmp13
