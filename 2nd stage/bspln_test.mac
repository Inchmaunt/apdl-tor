*USE, ansuitmp13
'
*DO, i, 1, lowNodes,1
    K,i, lowcxcorrosion(i,2,1), Y_NEW(i), 0,
*ENDDO 



BSPLN,241,240,239,238,237,236,235,234,233,232,231,230











R2=50 !наружный радиус сечерия тора

h=R2/5 !толщина
!h=1.9802
r1=R2-h !внутренний радиус сечерия тора
R = r1          ! Радиус идеальной окружности
CENTER_X = 0   ! Координаты центра
CENTER_Y = 0.0
THRESHOLD_ANGLE = 175  ! Порог для угла (градусы)
THRESHOLD_DIST = 0.05  ! Допуск отклонения от радиуса (5%)
Pi=ACOS(-1)  !число пи




! Коэффициенты для 7-точечного сглаживания внутренних узлов (можно менять)
W_CENTER = 7      ! Вес центрального узла
W_1 = 6           ! Вес для соседей ±1
W_2 = 3           ! Вес для соседей ±2 
W_3 = -2          ! Вес для соседей ±3
DENOM = 21        ! Знаменатель


DENOM = W_CENTER+ 2*W_1 + 2*W_2 + 2*W_3 ! Знаменатель

! Сглаживание первых 3 узлов
! Коэффициенты для сглаживания (можно менять)
W1_0 = 39    ! Вес для узла 1 (центральный)
W1_1 = 8     ! Вес для узла 1 (сосед 1)
W1_2 = -4    ! Вес для узла 1 (сосед 2)
W1_3 = -7    ! Вес для узла 1 (сосед 3)
W1_4 = 4     ! Вес для узла 1 (сосед 4)
DENOM1 = 42  ! Знаменатель для узла 1

W2_0 = 8     ! Вес для узла 2 (центральный)
W2_1 = 19    ! Вес для узла 2 (сосед 1)
W2_2 = 16    ! Вес для узла 2 (сосед 2)
W2_3 = 6     ! Вес для узла 2 (сосед 3)
W2_4 = -4    ! Вес для узла 2 (сосед 4)
W2_5 = 1     ! Вес для узла 2 (сосед 5)
W2_6 = -2    ! Вес для узла 2 (сосед 6)
DENOM2 = 42  ! Знаменатель для узла 2

W3_0 = -4    ! Вес для узла 3 (центральный)
W3_1 = 16    ! Вес для узла 3 (сосед 1)
W3_2 = 19    ! Вес для узла 3 (сосед 2)
W3_3 = 12    ! Вес для узла 3 (сосед 3)
W3_4 = 2     ! Вес для узла 3 (сосед 4)
W3_5 = -4    ! Вес для узла 3 (сосед 5)
W3_6 = 1     ! Вес для узла 3 (сосед 6)
DENOM3 = 42  ! Знаменатель для узла 3




! Коэффициенты для последних 3 узлов (можно менять)
! Узел N_NODE-2 (предпредпоследний)
WN2_0 = 1      ! Вес для N_NODE-6
WN2_1 = -4     ! Вес для N_NODE-5
WN2_2 = 2      ! Вес для N_NODE-4
WN2_3 = 12     ! Вес для N_NODE-3
WN2_4 = 19     ! Вес для N_NODE-2 (центральный)
WN2_5 = 16     ! Вес для N_NODE-1
WN2_6 = -4     ! Вес для N_NODE
DENOM_N2 = 42  ! Знаменатель

! Узел N_NODE-1 (предпоследний)
WN1_0 = 4      ! Вес для N_NODE-6
WN1_1 = -7     ! Вес для N_NODE-5
WN1_2 = -4     ! Вес для N_NODE-4
WN1_3 = 6      ! Вес для N_NODE-3
WN1_4 = 16     ! Вес для N_NODE-2
WN1_5 = 19     ! Вес для N_NODE-1 (центральный)
WN1_6 = 8      ! Вес для N_NODE
DENOM_N1 = 42  ! Знаменатель

! Узел N_NODE (последний)
WN_0 = -2      ! Вес для N_NODE-6
WN_1 = 4       ! Вес для N_NODE-5
WN_2 = 1       ! Вес для N_NODE-4
WN_3 = -4      ! Вес для N_NODE-3
WN_4 = -4      ! Вес для N_NODE-2
WN_5 = 8       ! Вес для N_NODE-1
WN_6 = 39      ! Вес для N_NODE (центральный)
DENOM_N = 42   ! Знаменатель

*DO, i, 1, lowNodes-1,1
    LSTR, i, i+1
*ENDDO 


*DIM, AB, ARRAY,lowNodes,4

*DO, I, 1, lowNodes

  ! Координаты текущего узла
  NODE_X(I) = lowcxcorrosion(i,2,1)
  NODE_Y(I) = Y_NEW(i)

  ! Проверка угла (если не на границе)
  *IF, I, GT, 1, AND, I, LT, lowNodes, THEN
    ! Вектора a (P_i-1 -> P_i) и b (P_i -> P_i+1)
    ! AX = lowcxcorrosion(i,2,1) - lowcxcorrosion(i-1,2,1)
    ! AY = NODE_Y(i) - NODE_Y(i-1)
    ! BX = lowcxcorrosion(i+1,2,1) - lowcxcorrosion(i,2,1)
    ! BY = NODE_Y(i+1) - NODE_Y(i)

    AB(I,1) = ABS(lowcxcorrosion(i,2,1) - lowcxcorrosion(i-1,2,1))
    AB(I,2) = ABS(NODE_Y(i) - NODE_Y(i-1))
    AB(I,3) = ABS(lowcxcorrosion(i+1,2,1) - lowcxcorrosion(i,2,1))
    AB(I,4) = ABS(NODE_Y(i+1) - NODE_Y(i))    


    ! Косинус угла
    COS_THETA = (AB(I,1)*AB(I,3) + AB(I,2)*AB(I,4))/(SQRT(AB(I,1)**2 + AB(I,2)**2)*SQRT(AB(I,3)**2 + AB(I,4)**2))
    THETA(I) = 180 - ACOS(COS_THETA)*180/Pi  ! В градусах

    *IF, THETA(I), LT, THRESHOLD_ANGLE, THEN
      DEFECTIVE(I) = 1  ! Пометить как дефектный
    *ENDIF
    
  *ENDIF
*ENDDO




*DIM, Y_NEW_NEW, ARRAY, lowNodes
*DIM, X_NEW_NEW, ARRAY, lowNodes

! 3. Применение 7-точечного сглаживания ТОЛЬКО к дефектным узлам
*DO, I, 4, lowNodes-3  ! Игнорируем граничные узлы

  ! Координаты текущего узла
  NODE_X(I) = lowcxcorrosion(i,2,1)
  NODE_Y(I) = Y_NEW(i)

  *IF, DEFECTIVE(I), EQ, 1, THEN
    ! Формула сглаживания с использованием коэффициентов
    TERM1 = W_CENTER*NODE_Y(I)
    TERM2 = W_1*(NODE_Y(I+1) + NODE_Y(I-1))
    TERM3 = W_2*(NODE_Y(I+2) + NODE_Y(I-2)) 
    TERM4 = W_3*(NODE_Y(I+3) + NODE_Y(I-3))
    Y_NEW_NEW(I) = (TERM1 + TERM2 + TERM3 + TERM4)/DENOM

    TERM1_X = W_CENTER*NODE_X(I)
    TERM2_X = W_1*(NODE_X(I+1) + NODE_X(I-1))
    TERM3_X = W_2*(NODE_X(I+2) + NODE_X(I-2)) 
    TERM4_X = W_3*(NODE_X(I+3) + NODE_X(I-3))
    X_NEW_NEW(I) = (TERM1_X + TERM2_X + TERM3_X + TERM4_X)/DENOM
  *ELSE
    Y_NEW_NEW(I) = Y_NEW(i,1,1)  ! Без изменений
    X_NEW_NEW(I) = NODE_X(I)
  *ENDIF
*ENDDO

! -----------------------------------------------
! СГЛАЖИВАНИЕ КРАЕВЫХ УЗЛОВ (1, 2, 3)
! -----------------------------------------------
*IF, N_NODE, GE, 7, THEN  ! Проверка, что узлов достаточно
  ! Узел 1
  *IF, DEFECTIVE(1), EQ, 1, THEN
    TERM1 = W1_0*NODE_Y(1) + W1_1*NODE_Y(2)
    TERM2 = W1_2*(NODE_Y(3) + NODE_Y(4) - NODE_Y(5))
    TERM3 = W1_3*NODE_Y(6) + W1_4*NODE_Y(7)
    Y_NEW_NEW(1) = (TERM1 + TERM2 + TERM3)/DENOM1

    TERM1_X = W1_0*NODE_X(1) + W1_1*NODE_X(2)
    TERM2_X = W1_2*(NODE_X(3) + NODE_X(4) - NODE_X(5))
    TERM3_X = W1_3*NODE_X(6) + W1_4*NODE_X(7)
    X_NEW_NEW(1) = (TERM1_X + TERM2_X + TERM3_X)/DENOM1

  *ELSE
    Y_NEW_NEW(1) = NODE_Y(1)
    X_NEW_NEW(1) = NODE_X(1)
  *ENDIF
  
  ! Узел 2
  *IF, DEFECTIVE(2), EQ, 1, THEN
    TERM1 = W2_0*NODE_Y(1) + W2_1*NODE_Y(2)
    TERM2 = W2_2*NODE_Y(3) + W2_3*NODE_Y(4)
    TERM3 = W2_4*NODE_Y(5) + W2_5*NODE_Y(6) + W2_6*NODE_Y(7)
    Y_NEW_NEW(2) = (TERM1 + TERM2 + TERM3)/DENOM2


    TERM1_XX = W2_0*NODE_X(1) + W2_1*NODE_X(2)
    TERM2_XX = W2_2*NODE_X(3) + W2_3*NODE_X(4)
    TERM3_XX = W2_4*NODE_X(5) + W2_5*NODE_X(6) + W2_6*NODE_X(7)
    X_NEW_NEW(2) = (TERM1_XX + TERM2_XX + TERM3_XX)/DENOM2
  *ELSE
    Y_NEW_NEW(2) = NODE_Y(2)
    X_NEW_NEW(2) = NODE_X(2)
  *ENDIF
  
  ! Узел 3
  *IF, DEFECTIVE(3), EQ, 1, THEN
    TERM1 = W3_0*NODE_Y(1) + W3_1*NODE_Y(2) + W3_2*NODE_Y(3)
    TERM2 = W3_3*NODE_Y(4) + W3_4*NODE_Y(5)
    TERM3 = W3_5*NODE_Y(6) + W3_6*NODE_Y(7)
    Y_NEW_NEW(3) = (TERM1 + TERM2 + TERM3)/DENOM3

    TERM1_X = W3_0*NODE_X(1) + W3_1*NODE_X(2) + W3_2*NODE_X(3)
    TERM2_X = W3_3*NODE_X(4) + W3_4*NODE_X(5)
    TERM3_X = W3_5*NODE_X(6) + W3_6*NODE_X(7)
    X_NEW_NEW(3) = (TERM1_X + TERM2_X + TERM3_X)/DENOM3
  *ELSE
    Y_NEW_NEW(3) = NODE_Y(3)
    X_NEW_NEW(3) = NODE_X(3)
  *ENDIF
*ENDIF

! -----------------------------------------------
! СГЛАЖИВАНИЕ ПОСЛЕДНИХ ТРЕХ УЗЛОВ
! -----------------------------------------------
*IF, N_NODE, GE, 7, THEN
  ! Узел N_NODE-2
  *IF, DEFECTIVE(N_NODE-2), EQ, 1, THEN
    TERM1 = WN2_0*NODE_Y(N_NODE-6) + WN2_1*NODE_Y(N_NODE-5)
    TERM2 = WN2_2*NODE_Y(N_NODE-4) + WN2_3*NODE_Y(N_NODE-3)
    TERM3 = WN2_4*NODE_Y(N_NODE-2) + WN2_5*NODE_Y(N_NODE-1)
    TERM4 = WN2_6*NODE_Y(N_NODE)
    Y_NEW_NEW(N_NODE-2) = (TERM1 + TERM2 + TERM3 + TERM4)/DENOM_N2


    TERM1_X = WN2_0*NODE_X(N_NODE-6) + WN2_1*NODE_X(N_NODE-5)
    TERM2_X = WN2_2*NODE_X(N_NODE-4) + WN2_3*NODE_X(N_NODE-3)
    TERM3_X = WN2_4*NODE_X(N_NODE-2) + WN2_5*NODE_X(N_NODE-1)
    TERM4_X = WN2_6*NODE_X(N_NODE)
    X_NEW_NEW(N_NODE-2) = (TERM1_X + TERM2_X + TERM3_X + TERM4_X)/DENOM_N2
  *ELSE
    Y_NEW_NEW(N_NODE-2) = NODE_Y(N_NODE-2)
    X_NEW_NEW(N_NODE-2)=  lowcxcorrosion(N_NODE-2,2,1)
  *ENDIF
  
  ! Узел N_NODE-1
  *IF, DEFECTIVE(N_NODE-1), EQ, 1, THEN
    TERM1 = WN1_0*NODE_Y(N_NODE-6) + WN1_1*NODE_Y(N_NODE-5)
    TERM2 = WN1_2*NODE_Y(N_NODE-4) + WN1_3*NODE_Y(N_NODE-3)
    TERM3 = WN1_4*NODE_Y(N_NODE-2) + WN1_5*NODE_Y(N_NODE-1)
    TERM4 = WN1_6*NODE_Y(N_NODE)
    Y_NEW_NEW(N_NODE-1) = (TERM1 + TERM2 + TERM3 + TERM4)/DENOM_N1

    TERM1_X = WN1_0*NODE_X(N_NODE-6) + WN1_1*NODE_X(N_NODE-5)
    TERM2_X = WN1_2*NODE_X(N_NODE-4) + WN1_3*NODE_X(N_NODE-3)
    TERM3_X = WN1_4*NODE_X(N_NODE-2) + WN1_5*NODE_X(N_NODE-1)
    TERM4_X = WN1_6*NODE_X(N_NODE)
    X_NEW_NEW(N_NODE-1) = (TERM1_X + TERM2_X + TERM3_X + TERM4_X)/DENOM_N1


  *ELSE
    Y_NEW_NEW(N_NODE-1) = NODE_Y(N_NODE-1)
    X_NEW_NEW(N_NODE-1)=  lowcxcorrosion(N_NODE-1,2,1)
  *ENDIF
  
  ! Узел N_NODE
  *IF, DEFECTIVE(N_NODE), EQ, 1, THEN
    TERM1 = WN_0*NODE_Y(N_NODE-6) + WN_1*NODE_Y(N_NODE-5)
    TERM2 = WN_2*NODE_Y(N_NODE-4) + WN_3*NODE_Y(N_NODE-3)
    TERM3 = WN_4*NODE_Y(N_NODE-2) + WN_5*NODE_Y(N_NODE-1)
    TERM4 = WN_6*NODE_Y(N_NODE)
    Y_NEW_NEW(N_NODE) = (TERM1 + TERM2 + TERM3 + TERM4)/DENOM_N


    TERM1_X = WN_0*NODE_X(N_NODE-6) + WN_1*NODE_X(N_NODE-5)
    TERM2_X = WN_2*NODE_X(N_NODE-4) + WN_3*NODE_X(N_NODE-3)
    TERM3_X = WN_4*NODE_X(N_NODE-2) + WN_5*NODE_X(N_NODE-1)
    TERM4_X = WN_6*NODE_X(N_NODE)
    X_NEW_NEW(N_NODE) = (TERM1_X + TERM2_X + TERM3_X + TERM4_X)/DENOM_N

  *ELSE
    Y_NEW_NEW(N_NODE) = NODE_Y(N_NODE)
    X_NEW_NEW(N_NODE)=  lowcxcorrosion(N_NODE,2,1)
  *ENDIF
*ENDIF


*DO, i, 1, lowNodes,1
    K,i+1000, X_NEW_NEW(i), Y_NEW_NEW(i), 0,
*ENDDO

*DO, i, 1, lowNodes-1,1
    LSTR, i+1000, i+1+1000
*ENDDO 