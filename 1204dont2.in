
/PREP7  
 
ET,1,PLANE182   
ET,2,172


KEYOPT,1,1,0
KEYOPT,1,3,0
KEYOPT,1,6,0

!*  
!*  
MPTEMP,,,,,,,,  
MPTEMP,1,0  
MPDATA,EX,1,,2e5   
MPDATA,PRXY,1,,0.3  
MPTEMP,,,,,,,,  
MPTEMP,1,0  
MPDATA,DENS,1,,7.8e-6

K,1,0,0,0
K,2,0,1,0

K,3,50,0,0
K,4,50,1,0
LSTR,1,2
LSTR,1,3
LSTR,3,4
LSTR,2,4
AL,ALL
AMESH,1

N,9999,50,5,0

b=2
dist = SQRT((NX(5)-b)**2 + NY(5)**2)
weight_first = 1/dist

CE,100,HIGH,9999,UY,1.0,5,UY,-weight_first
DL,1,2,ALL
F,9999,FX,1000





/PREP7  

! 1. Настройки элемента
ET,1,PLANE182   
KEYOPT,1,3,0    ! Плоская постановка (не осесимметричная)


ET,8,MPC184 
!*  
KEYOPT,8,1,0
KEYOPT,8,2,0

! 2. Материал
MP,EX,1,2e5   
MP,PRXY,1,0.3  
MP,DENS,1,7.8e-6

! 3. Геометрия
K,1,0,0,0
K,2,0,1,0
K,3,50,0,0
K,4,50,1,0
LSTR,1,2
LSTR,1,3
LSTR,3,4
LSTR,2,4
AL,ALL

! 4. Сетка
ESIZE,5         ! Размер элемента 5 единиц
AMESH,1

! 5. Создаем Remote Point и СВЯЗЫВАЕМ его с моделью
! Добавляем узел в существующий элемент или создаем новый
N,9999,50,5,0
TYPE,8
MAT,1
E,3,9999      ! Создаем новый элемент, связывающий Remote Point с моделью
! или альтернативно: E,3,4,9999

! 6. Создаем уравнение связи
! Выбираем узлы на правом конце (x=50)
NSEL,S,LOC,X,50
*GET,nNodes,NODE,0,COUNT

! Первый узел (номер 5 по вашей нумерации)
n_first = 3
dist = SQRT((NX(n_first)-50)**2 + (NY(n_first)-5)**2)
weight_first = 1/dist

CE,100,0,9999,UY,1.0,n_first,UY,-weight_first

! 7. Граничные условия
DL,1,2,ALL      ! Закрепление левого конца

! 8. Нагрузка
F,9999,FY,-1000   ! Горизонтальная сила

! 9. Решение
ALLSEL,ALL
/SOLU
SOLVE
FINISH

/POST1
PLNSOL,U,SUM     ! Визуализация перемещений