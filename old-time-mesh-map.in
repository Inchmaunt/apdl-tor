/PREP7  
 
ET,1,PLANE182   

KEYOPT,1,1,0
KEYOPT,1,3,1
KEYOPT,1,6,0

!*  
MPTEMP,,,,,,,,  
MPTEMP,1,0  
MPDATA,EX,1,,2e5   
MPDATA,PRXY,1,,0.3  
MPTEMP,,,,,,,,  
MPTEMP,1,0  
MPDATA,DENS,1,,7.8e-6

!==========================================================================
!========================== ФАЙЛЫ =========================================

!/DELETE, D:\meshcheck, txt

*CREATE,ansuitmp16
*CFOPEN, 'D:\meshcheck', txt,,append
*VWRITE,t1,DEPminthick,DEPmaxstress,Coordofmax,DEPmaxstressouter, Coordofmaxouter,elemcount,timesize,,, , , ,, , , ,
(8f10.3)
*CFCLOS
*END

!===========================================================================================================
!========================== ИСХОДНЫЕ ДАННЫЕ ГЕОМЕТРИЧЕСКИЕ РАЗМЕРЫ =========================================


    R2=50 !наружный радиус сечерия тора

    refh=0.2 !относительная толщина

    h=R2*refh !толщина

    r1=R2-h !внутренний радиус сечерия тора

    rc1=(R2+r1)/2 !срединный радиус поперечного сечения тора

    refb=3 !относительный радиус окружности тора

    b=refb*R2 !радиус окружности тора

    smax=450 !SMAX для случая с b=2 R1 равно 350, для случая с b-20 R1 равно 408

    iniload=0.25 !коэффициент начального нагружения (в долях процента, для процента надо домножить на 100)

    initialstress=iniload*smax

    pr=(2*h*smax*iniload)/rc1*(b-rc1)/(2*b-rc1) !давление
    !pr=1
    po=1e-6

    elemcount=24 !число разбиений сетки

    Pi=ACOS(-1)  !число пи

    tn = 1000 !техническое число

    k=1 ! В статье принята обратная величина, то есть расчет ведется для 1/k

    t1=0 !начальный момент времени

    ai=0.05
    !mi=0
    mi=ai/(k*smax)

    ao=0.05
    !ao=0
    !mo=0
    mo=ao/(k*smax)

    timesize=0.01 !шаг по времени в задаче

    linesize=20    !число разбиений на плоскостях симметрии
    meshsize=1    !размер элементов сетки
    h2=0.1*h

    
!==========================================================================================================
!==================================================== ЦИКЛ ================================================

    !====================================== ЦИКЛ ПО ВРЕМЕНИ ====================================
        *DO, timesize, 0.5,0.5, 0.05
        
        !====================================== ЦИКЛ ПО СЕТКЕ ==================================
            *DO, elemcount, 180,360,60
            /CLEAR
            

                !===========================================================================================================
                !========================== ИСХОДНЫЕ ДАННЫЕ ГЕОМЕТРИЧЕСКИЕ РАЗМЕРЫ =========================================


                    R2=50 !наружный радиус сечерия тора

                    refh=0.2 !относительная толщина

                    h=R2*refh !толщина

                    r1=R2-h !внутренний радиус сечерия тора

                    rc1=(R2+r1)/2 !срединный радиус поперечного сечения тора

                    refb=3 !относительный радиус окружности тора

                    b=refb*R2 !радиус окружности тора

                    smax=450 !SMAX для случая с b=2 R1 равно 350, для случая с b-20 R1 равно 408

                    iniload=0.25 !коэффициент начального нагружения (в долях процента, для процента надо домножить на 100)

                    initialstress=iniload*smax

                    pr=(2*h*smax*iniload)/rc1*(b-rc1)/(2*b-rc1) !давление
                    !pr=1
                    po=1e-6

                    elemcount=24 !число разбиений сетки

                    Pi=ACOS(-1)  !число пи

                    tn = 1000 !техническое число

                    k=1 ! В статье принята обратная величина, то есть расчет ведется для 1/k

                    t1=0 !начальный момент времени

                    ai=0.05
                    !mi=0
                    mi=ai/(k*smax)

                    ao=0.05
                    !ao=0
                    !mo=0
                    mo=ao/(k*smax)

                    timesize=0.01 !шаг по времени в задаче

                    linesize=20    !число разбиений на плоскостях симметрии
                    meshsize=1    !размер элементов сетки
                    h2=0.1*h





                !==================массивы для задачи==================

                *DEL, lowcxcorrosion, array, elemcount+1, 3
                *DEL, highcxcorrosion, array, elemcount+1, 3
                *DEL, thickness, array, elemcount+1, 3
                *DEL, testset, array, elemcount+1,4
                *DEL, lowcXcyl, array, elemcount+1, 3
                *DEL, highcXcyl, array, elemcount+1, 3


                ALLSEL  
                /PREP7                  
                LSCLEAR,ALL 
                ACLEAR,1
                ADELE, ALL
                LDELE,All
                KDELE,All



                *DIM, lowcXcyl, array, elemcount+1, 3
                *DIM, highcXcyl, array, elemcount+1, 3
                *DIM, lowcxcorrosion, array, elemcount+1, 3
                *DIM, highcxcorrosion, array, elemcount+1, 3
                *DIM, thickness, array, elemcount+1, 3
                *DIM, testset, array, elemcount+1,6


                CSYS,0
                *DO, i, 0, elemcount,1
                    lowcXcyl(i+1,1,1) = Pi/elemcount*i
                    lowcXcyl(i+1,2,1) = b+(R2-h)*COS(Pi/elemcount*i)
                    lowcXcyl(i+1,3,1) = (R2-h)*SIN( Pi/elemcount*i)
                    K,i+1, lowcXcyl(i+1,2,1), lowcXcyl(i+1,3,1), 0,
                *ENDDO 

                *DO, i, 0, elemcount,1
                    highcXcyl(i+1,1,1) = Pi/elemcount*i
                    highcXcyl(i+1,2,1) = b+R2*COS(Pi/elemcount*i)
                    highcXcyl(i+1,3,1) = R2*SIN( Pi/elemcount*i)
                K,i+1+tn,highcXcyl(i+1,2,1),highcXcyl(i+1,3,1),0,
                *ENDDO 

                *DO, i, 0, elemcount, 1
                    thickness(i+1,1,1) = Pi/elemcount*i
                    thickness(i+1,2,1) = thickness(i+1,1,1)/Pi*180
                    thickness(i+1,3,1) = ((highcXcyl(i+1,2,1)-lowcXcyl(i+1,2,1))**2 + (highcXcyl(i+1,3,1)-lowcXcyl(i+1,3,1))**2)**0.5
                *ENDDO

                *DO, i, 1, elemcount,1
                    LSTR, i, i+1
                *ENDDO 

                *DO, i, 1, elemcount,1
                    LSTR, i+tn, i+1+tn
                *ENDDO 


                LSTR, 1, 1+tn
                LSTR, elemcount+1, elemcount+1+tn

                *DO, i, 1, elemcount
                    LESIZE,i, , ,1, , , , ,1
                *ENDDO
                *DO, i, elemcount+1, 2*elemcount
                    LESIZE,i, , ,1, , , , ,1
                *ENDDO

                AL,ALL
                AMAP,1,1,elemcount+1,1001,elemcount+1000+1

                LOCAL,112,1,b,0,0, , , ,1,1,
                NROTAT,ALL
                LSCLEAR,ALL 

                *DO, i, 1, elemcount,1
                    SFL,i,PRES,pr,
                *ENDDO

                *DO, i, elemcount+1, elemcount+elemcount,1
                    SFL,i,PRES,po,
                *ENDDO

                DL,elemcount*2+1,1, SYMM, ,  
                DL,elemcount*2+2,1, SYMM, ,  

                CSYS,0 
                CSYS,112

                FINISH  
                /SOL
                !/STATUS,SOLU
                SOLVE
                /Post1
                RSYS,112

                KSEL, S, KP,,1,elemcount+1
                NSLK,S
                *GET, nodelow, NODE,0, COUNT
                Selnode=0

                *Do,i,1,nodelow
                    NodeNo=NDNEXT(SelNode) !NDNEXT(N) Next selected node having a node number greater than N.
                    testset(i,1,1)= NodeNo
                    *GET,testset(i,2,1),NODE,testset(i,1,1),S,Y
                    SelNode=NodeNo
                    testset(i,5,1)=Pi/elemcount*i
                *Enddo

                KSEL,ALL

                KSEL, S, KP,,tn+1,tn+elemcount+1
                NSLK,S
                *GET, nodehigh, NODE,0, COUNT
                Selnode=0

                *Do,i,1,nodehigh
                    NodeNo=NDNEXT(SelNode) !NDNEXT(N) Next selected node having a node number greater than N.
                    testset(i,3,1)= NodeNo
                    *GET,testset(i,4,1),NODE,testset(i,3,1),S,Y
                    SelNode=NodeNo
                    testset(i,6,1)=Pi/elemcount*i
                *Enddo

                !вычисляем новую геометрию по коррозии
                *DO, i, 0, nodelow-1, 1
                    lowcxcorrosion(i+1,1,1) = Pi/elemcount*i
                    lowcxcorrosion(i+1,2,1) = b+((R2-h)+(ai+(testset(i+1,2,1))*mi)*t1)*COS(Pi/elemcount*i)
                    lowcxcorrosion(i+1,3,1) = ((R2-h)+(ai+(testset(i+1,2,1))*mi)*t1)*SIN(Pi/elemcount*i) 
                *ENDDO


                *DO, i, 0, nodehigh-1, 1
                    highcxcorrosion(i+1,1,1) = Pi/elemcount*i
                    highcxcorrosion(i+1,2,1) = b+(R2-(ao+(testset(i+1,4,1))*mo)*t1)*COS(Pi/elemcount*i)
                    highcxcorrosion(i+1,3,1) = (R2-(ao+(testset(i+1,4,1))*mo)*t1)*SIN(Pi/elemcount*i)
                *ENDDO


                *DO, i, 0, nodelow-1, 1
                    thickness(i+1,1,1) = Pi/elemcount*i
                    thickness(i+1,2,1) = thickness(i+1,1,1)/Pi*180
                    thickness(i+1,3,1) = ((highcxcorrosion(i+1,2,1)-lowcxcorrosion(i+1,2,1))**2 + (highcxcorrosion(i+1,3,1)-lowcxcorrosion(i+1,3,1))**2)**0.5
                *ENDDO


                !====================================== ВРЕМЕННОЙ ЦИКЛ =========================
                *DO, t1, 0, 100, timesize  


                    *DEL, lowcxcorrosion, array, elemcount+1, 3
                    *DEL, highcxcorrosion, array, elemcount+1, 3
                    *DEL, thickness, array, elemcount+1, 3
                    *DEL, testset, array, elemcount+1,4


                    *DIM, lowcxcorrosion, array, elemcount+1, 3
                    *DIM, highcxcorrosion, array, elemcount+1, 3
                    *DIM, thickness, array, elemcount+1, 3
                    *DIM, testset, array, elemcount+1,6

                    /Post1                   
                    RSYS,112


                    KSEL, S, KP,,1,elemcount+1
                    NSLK,S
                    *GET, nodelow, NODE,0, COUNT
                    Selnode=0

                    *Do,i,1,nodelow
                        NodeNo=NDNEXT(SelNode) !NDNEXT(N) Next selected node having a node number greater than N.
                        testset(i,1,1)= NodeNo
                        *GET,testset(i,2,1),NODE,testset(i,1,1),S,Y
                        SelNode=NodeNo
                        testset(i,5,1)=Pi/elemcount*i
                    *Enddo

                    KSEL,ALL

                    KSEL, S, KP,,tn+1,tn+elemcount+1
                    NSLK,S
                    *GET, nodehigh, NODE,0, COUNT
                    Selnode=0

                    *Do,i,1,nodehigh
                        NodeNo=NDNEXT(SelNode) !NDNEXT(N) Next selected node having a node number greater than N.
                        testset(i,3,1)= NodeNo
                        *GET,testset(i,4,1),NODE,testset(i,3,1),S,Y
                        SelNode=NodeNo
                        testset(i,6,1)=Pi/elemcount*i
                    *Enddo

                    !вычисляем новую геометрию по коррозии
                    *DO, i, 0, elemcount, 1
                        lowcxcorrosion(i+1,1,1) = Pi/elemcount*i
                        lowcxcorrosion(i+1,2,1) = b+((R2-h)+(ai+(testset(i+1,2,1))*mi)*t1)*COS(Pi/elemcount*i)
                        lowcxcorrosion(i+1,3,1) = ((R2-h)+(ai+(testset(i+1,2,1))*mi)*t1)*SIN(Pi/elemcount*i) 
                    *ENDDO


                    *DO, i, 0, elemcount, 1
                        highcxcorrosion(i+1,1,1) = Pi/elemcount*i
                        highcxcorrosion(i+1,2,1) = b+(R2-(ao+(testset(i+1,4,1))*mo)*t1)*COS(Pi/elemcount*i)
                        highcxcorrosion(i+1,3,1) = (R2-(ao+(testset(i+1,4,1))*mo)*t1)*SIN(Pi/elemcount*i)
                    *ENDDO


                    *DO, i, 0, elemcount, 1
                        thickness(i+1,1,1) = Pi/elemcount*i
                        thickness(i+1,2,1) = thickness(i+1,1,1)/Pi*180
                        thickness(i+1,3,1) = ((highcxcorrosion(i+1,2,1)-lowcxcorrosion(i+1,2,1))**2 + (highcxcorrosion(i+1,3,1)-lowcxcorrosion(i+1,3,1))**2)**0.5
                    *ENDDO
                    
                    ALLSEL  
                    /PREP7                  
                    LSCLEAR,ALL 
                    ACLEAR,1
                    ADELE, ALL
                    LDELE,All
                    KDELE,All

                    CSYS,0

                    *DO, i, 0, elemcount,1
                        K,i+1,lowcxcorrosion(i+1,2,1),lowcxcorrosion(i+1,3,1),0,
                    *ENDDO

                    *DO, i, 1, elemcount,1
                        LSTR, i, i+1
                    *ENDDO

                    *DO, i, 0, elemcount,1
                        K,i+tn+1,highcxcorrosion(i+1,2,1),highcxcorrosion(i+1,3,1),0,
                    *ENDDO

                    *DO, i, 1, elemcount,1
                        LSTR, i+tn, i+1+tn
                    *ENDDO

                   
                    LSTR, 1, 1+tn
                    LSTR, elemcount+1, elemcount+1+tn

                    *DO, i, 1, elemcount
                        LESIZE,i, , ,1, , , , ,1
                    *ENDDO
                    *DO, i, elemcount+1, 2*elemcount
                        LESIZE,i, , ,1, , , , ,1
                    *ENDDO



                    AL,ALL
                    AMAP,1,1,elemcount+1,1001,elemcount+1000+1

                    
                    *DO, i, 1, elemcount,1
                        SFL,i,PRES,pr,
                    *ENDDO

                    *DO, i, elemcount+1, elemcount+elemcount,1
                        SFL,i,PRES,po,
                    *ENDDO

                    DL,elemcount*2+1,1, SYMM, ,  
                    DL,elemcount*2+2,1, SYMM, ,  
                    CSYS,0 
                    CSYS,112
                    !переходим в обычную СК и решаем

                    CSYS,0 
                    FINISH  
                    /SOL
                    SOLVE

                    !результаты (время, максимальное напряжение в узле, координата узла, минимальная толщина в узле)
                        
                    !массивы для расчета напряжений
                    *VSCFUN, DEPmaxstress, MAX, testset(1,2)
                    *VSCFUN, DEPmaxstressouter, MAX, testset(1,4)

                    !max напряжения на внутренней поверхности
                    *VSCFUN, locstress, LMAX, testset(1,2)
                    Coordofmax = testset(locstress,5)*180/Pi

                    !max напряжения на внешней поверхности
                    *VSCFUN, locstressouter, LMAX, testset(1,4)
                    Coordofmaxouter = testset(locstressouter,6)*180/Pi   

                    !расчет толщины
                    *VSCFUN, DEPminthick, MIN, thickness(1,3)
                    *VSCFUN, locminthick, LMIN, thickness(1,3)
                    Coordofminthick = thickness(locminthick,2)
                    *VSCFUN, DEPmaxthick, MAX, thickness(1,3)
                    halfof=(DEPmaxstress-initialstress)/(smax-initialstress)


                    *IF, DEPminthick,LT,h2,OR,DEPmaxstress,GT,smax,EXIT
                    
                *ENDDO
                *use, ansuitmp16

                RSYS,112
                CSYS,112
                /Post1
                /EFACET,1   
                PLNSOL, S, Y, 2, 5.0   

                !SCREENSHOT
                !*
                !*
                /RGB,INDEX,100,100,100, 0   
                /RGB,INDEX, 80, 80, 80,13   
                /RGB,INDEX, 60, 60, 60,14   
                /RGB,INDEX, 0, 0, 0,15  
                /SHOW,PNG,,0
                PNGR,COMP,1,-1  
                PNGR,ORIENT,HORIZ   
                PNGR,COLOR,2
                PNGR,TMOD,1 
                /GFILE,1600, 
                !*
                !*
                /REPLOT 
                /SHOW,CLOSE 
                /DEVICE,VECTOR,0
                !*
                !*
                !END OF SCREENSHOT
            *ENDDO

        *ENDDO